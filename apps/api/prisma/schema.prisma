// Stabilitea data model. Money is integer cents; months are 'YYYY-MM'; dates are 'YYYY-MM-DD'.
// The database URL lives in prisma.config.ts (DATABASE_URL, default file:../../data/stabilitea.db).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

/// Parent bucket for display and grouping.
model Group {
  id            Int           @id @default(autoincrement())
  name          String
  /// 'income' | 'expense'
  kind          String
  sortOrder     Int           @default(0) @map("sort_order")
  archivedAt    DateTime?     @map("archived_at")
  categories Category[]

  @@map("category_group")
}

/// Where limits and transactions attach.
model Category {
  id                Int            @id @default(autoincrement())
  groupId        Int            @map("group_id")
  name              String
  defaultLimitCents Int            @default(0) @map("default_limit_cents")
  /// 'standard' | 'fund' | 'recurring'. Fund and recurring are expense only.
  /// standard: spending comes out of savings at close. fund: keeps its own balance month to month.
  /// recurring: stores a share of a bill each month; the payment comes from the stored money.
  type              String         @default("standard")
  /// Recurring bill amount, months per cycle, and the month it's next due ('YYYY-MM').
  billCents         Int?           @map("bill_cents")
  billMonths        Int?           @map("bill_months")
  nextDueMonth      String?        @map("next_due_month")
  sortOrder         Int            @default(0) @map("sort_order")
  archivedAt        DateTime?      @map("archived_at")
  group          Group       @relation(fields: [groupId], references: [id])
  budgetLines       BudgetLine[]
  transactions      Transaction[]
  savingsEntries    SavingsEntry[]

  @@unique([groupId, name])
  @@map("category")
}

/// One row per budgeted month.
model BudgetMonth {
  month              String         @id
  plannedIncomeCents Int            @default(0) @map("planned_income_cents")
  /// 'open' | 'closed'
  status             String         @default("open")
  closedAt           DateTime?      @map("closed_at")
  lines              BudgetLine[]
  savingsEntries     SavingsEntry[]

  @@map("budget_month")
}

/// One category's plan for one month.
model BudgetLine {
  id               Int            @id @default(autoincrement())
  month            String
  categoryId    Int            @map("category_id")
  limitCents       Int            @map("limit_cents")
  /// Fund balance, or money stored for a recurring bill, brought in from last month; set only by closing the prior
  /// month. Negative for a carried fund deficit.
  carryInCents     Int            @default(0) @map("carry_in_cents")
  /// Snapshot of the category's type for this month (open months follow the category).
  type             String         @default("standard")
  /// Recurring snapshot: bill, months per cycle and this cycle's due month. For a recurring line, limit_cents is the
  /// month's calculated share of the bill.
  billCents        Int?           @map("bill_cents")
  billMonths       Int?           @map("bill_months")
  dueMonth         String?        @map("due_month")
  /// Total moved from savings to cover this fund line's deficit this month.
  deficitPaidCents Int            @default(0) @map("deficit_paid_cents")
  budgetMonth      BudgetMonth    @relation(fields: [month], references: [month], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id])
  savingsEntries   SavingsEntry[]

  @@unique([month, categoryId])
  @@map("budget_line")
}

model Transaction {
  id            Int         @id @default(autoincrement())
  /// 'YYYY-MM-DD'. Month is derived from it.
  date          String
  /// 'income' | 'expense'; must match the group kind.
  type          String
  /// Always positive.
  amountCents   Int         @map("amount_cents")
  categoryId Int         @map("category_id")
  payee         String?
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([date])
  @@index([categoryId])
  @@map("transaction")
}

/// Savings ledger. The balance is the sum of amount_cents.
/// Closing a month writes 'income' (+), 'spending' (−, standard categories), 'fund_contribution'
/// (− a fund's limit), 'fund_release' (± a fund balance with no fund line to carry into), 'recurring_store'
/// (− a recurring bill's share) and 'recurring_release' (± what's left once the bill is paid).
/// 'deficit_payment' (−) is written when the user pays a fund's deficit from savings.
model SavingsEntry {
  id            Int          @id @default(autoincrement())
  kind          String
  /// Month whose close created it, or whose budget line the deficit payment covered.
  month         String
  categoryId Int?         @map("category_id")
  /// Budget line a deficit payment was applied to.
  budgetLineId  Int?         @map("budget_line_id")
  /// Positive adds to savings, negative takes from it.
  amountCents   Int          @map("amount_cents")
  createdAt     DateTime     @default(now()) @map("created_at")
  budgetMonth   BudgetMonth  @relation(fields: [month], references: [month])
  category   Category? @relation(fields: [categoryId], references: [id])
  budgetLine    BudgetLine?  @relation(fields: [budgetLineId], references: [id])

  @@index([month])
  @@index([budgetLineId])
  @@map("savings_entry")
}
